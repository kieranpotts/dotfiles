#
# This file SHOULD be used to extend and overwrite the default user-level Git
# configuration symlinked from `~/.gitconfig`. You SHOULD edit this file
# directly, rather than use the `git config --global` command.
# https://git-scm.com/docs/git-config
#

[user]

  # These settings determine what values end up in the `author` and `committer`
  # fields of commit objects.
  # https://git-scm.com/docs/git-config#Documentation/git-config.txt-username
  #
  # GitHub offers private email aliases for commits. Enable the setting
  # "Keep my email address private" in your GitHub email settings, then use the
  # provided no-reply email address below.
  email = [your-email-address]
  name = [your-name-or-username]

  # It is RECOMMENDED to sign your Git commits with a GPG key. Add the
  # key ID here.
  #signingkey = XXXXXXXXXXXXXXXX

[core]

  # Override the `ssh` command called internally by `git fetch` and `git push`.
  # Use this to load a different identity than the defauls, eg `~/.ssh/id_dsa`.
  #sshCommand = ssh -i ~/.ssh/id_rsa_xxxxxx

  # By default Git uses `less` to page output from commands like `git log` and
  # `git diff`. I prefer Delta, which is a pager with built-in syntax
  # highlighting: https://github.com/dandavison/delta. Other options include
  # `cat` (for disabling paging altogether), or using `less` with additional
  # arguments for customizing the pager behavior.
  #
  # Delta can be tricky to install in some environments, so this option is
  # commented-out by default.
  #pager = delta

[commit]

  # It is RECOMMENDED to enable GPG signing of commits. This helps to prevent
  # impersonation and ensures the integrity of your commit history.
  #gpgsign = true

[tag]

  # Same for tagging commits.
  #gpgsign = true

[gpg]

  # Specify the path to the GPG program. This is required if GPG is not in
  # your system `PATH`, or if you want to use a different version of GPG
  # than the default installed version.
  #program = /usr/local/bin/gpg

[interactive]

  # When an interactive command such as `git add --patch` shows a colorized
  # diff, Git will pipe the diff through the shell command defined by this
  # configuration variable. The command may further markup the diff before
  # rendering. This is how we pipe the diff through the Delta pager. Delta's
  # `--color-only` flag disables Delta from structurally changing the diff,
  # which is required to maintain compatibility with Git.
  # https://git-scm.com/docs/git-config
  #diffFilter = delta --color-only

[delta]

  # Custom configuration for the Delta pager, if enabled for paging.

  # This will need to be changed to true if the terminal uses a light theme.
  light = false

  # Show line numbers with diff output.
  line-numbers = true

  # Use `n` and `N` to move between diff sections.
  navigate = true

  # Show diffs in two vertical panels.
  # https://dandavison.github.io/delta/side-by-side-view.html
  side-by-side = true

# ------------------------------------------------------------------------------

# Optional includes. Use configuration like below to load different Git configs
# based on the current working directory in which `git` is being executed.
# This is useful for loading different [user] credentials and SSH keys.
# See https://git-scm.com/docs/git-config#_conditional_includes
#
# You can also override these settings on a per-repository basis using
# `git config --local --edit`.

#[includeIf "gitdir:~/code/work/"]
#  path = "~/dev/work/.gitconfig"

#[includeIf "gitdir:~/code/personal/"]
#  path = "~/dev/personal/.gitconfig"
