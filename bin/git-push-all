#!/bin/sh

# ==============================================================================
# Push all branches upstream.
#
# Usage:
#
# ```
# git rebase-all ([remote])
# ```
# ==============================================================================

# Get the name of the remote repository, default to origin.
remote=${1:-origin}

# Get the name of the current checked out branch.
current_branch=$(git rev-parse --abbrev-ref HEAD)

# Get the names of all local branches except the trunk branch
branches=$(git branch --format='%(refname:short)')

# Push each branch.
for branch in $branches; do
  git checkout $branch
  git push $remote $branch --follow-tags --force-with-lease
done

# Switch back to the original checked-out branch.
git checkout $current_branch
